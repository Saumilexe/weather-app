<%- include("partials/header.ejs") %>
<body class="<%= data.isDay ? '' : 'night' %>">
    <header class="topbar">
        <form class="search-form" method="post" action="/" role="search">
            <input type="search" name="city" placeholder="Search for a city" aria-label="City name" required>
            <button type="submit">Search</button>
        </form>
    </header>

    <main class="layout rise">
        <div class="primary">
            <section class="panel hero" aria-labelledby="city">
                <div>
                    <h1 id="city" class="city"><%= data.cityName %></h1>
                    <p class="temp"><%= data.currentTemp %><span>°C</span></p>
                    <p class="range">High <%= data.maxTemp %>°, low <%= data.minTemp %>°</p>
                </div>
                <div class="hero-condition">
                    <img src="<%= data.icon %>" alt="" width="128" height="128">
                    <p><%= data.condition %></p>
                </div>
            </section>

            <section class="panel" aria-labelledby="hourly-title">
                <h2 id="hourly-title">Next 24 hours</h2>
                <ul class="hourly">
                    <% data.hourly.forEach((h, i) => { %>
                        <li class="hour<%= i === 0 ? ' hour--now' : '' %>">
                            <span class="hour-label"><%= h.label %></span>
                            <img src="<%= h.icon %>" alt="<%= h.text %>" width="48" height="48" loading="lazy">
                            <span class="hour-temp"><%= h.temp %>°</span>
                        </li>
                    <% }) %>
                </ul>
            </section>

            <section class="panel" aria-labelledby="details-title">
                <h2 id="details-title">Details</h2>
                <dl class="stats">
                    <div><dt>Feels like</dt><dd><%= data.feelsLike %>°C</dd></div>
                    <div><dt>Humidity</dt><dd><%= data.humidity %>%</dd></div>
                    <div><dt>UV index</dt><dd><%= data.uv %> <small><%= data.uvLabel %></small></dd></div>
                    <div><dt>Wind</dt><dd><%= data.wind %> km/h <small><%= data.windDir %></small></dd></div>
                    <div><dt>Sunrise</dt><dd><%= data.sunrise %></dd></div>
                    <div><dt>Sunset</dt><dd><%= data.sunset %></dd></div>
                </dl>
            </section>
        </div>

        <section class="panel" aria-labelledby="days-title">
            <h2 id="days-title">3-day forecast</h2>
            <ul class="days">
                <% data.days.forEach((d) => { %>
                    <li class="day">
                        <img src="<%= d.icon %>" alt="" width="48" height="48" loading="lazy">
                        <div class="day-info">
                            <strong><%= d.label %></strong>
                            <span><%= d.text %>, <%= d.rain %>% chance of rain</span>
                        </div>
                        <span class="day-temps"><%= d.max %>° <small><%= d.min %>°</small></span>
                    </li>
                <% }) %>
            </ul>
        </section>
    </main>

    <%- include("partials/footer.ejs") %>
</body>
</html>
