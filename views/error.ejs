<%- include("partials/header.ejs") %>
<body>
    <main class="landing rise">
        <p class="eyebrow">City Weather</p>
        <h1>We couldn't get that weather</h1>
        <% if (locals.errorMessage) { %>
            <p class="lead"><%= errorMessage %></p>
        <% } %>
        <form class="search-form search-form--large" method="post" action="/" role="search">
            <input type="search" name="city" placeholder="Try another city" aria-label="City name" autofocus required>
            <button type="submit">Search</button>
        </form>
        <p><a class="text-link" href="/">Back to start</a></p>
    </main>
    <%- include("partials/footer.ejs") %>
</body>
</html>
